# omnish configuration
# Copy to $XDG_CONFIG_HOME/omnish/omnish.conf to activate.

# General
#OMNI_CD_ON_EXIT=1
#OMNI_USE_TRASH=1

# Opener
#OMNI_OPENER="xdg-open"

# Trash location
#OMNI_TRASH="${XDG_DATA_HOME:-$HOME/.local/share}/omnish/trash"

# Preview margin (chars from right edge)
#MARGIN_PREVIEW=60

# Image previews (Chafa only)
#OMNISH_IMAGE_FORMAT=auto   # auto | kitty | sixel | iterm | symbols
#OMNISH_IMAGE_QUALITY=high  # high | balanced | fast

# Terminal name (auto-detected if unset)
#MY_TERMINAL="kitty"